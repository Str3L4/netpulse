# =====================================================================
# NETPULSE ENVIRONMENT SECRETS TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# =====================================================================

# Router Credentials (e.g. MikroTik RouterOS)
MIKROTIK_HOST=192.168.1.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_router_password_here

# Linux Gateway / Server (e.g. Raspberry Pi, Debian, Ubuntu)
GATEWAY_HOST=192.168.1.254
GATEWAY_USER=your_linux_username
GATEWAY_PASSWORD=your_linux_password_here

# Google Gemini API Key (Optional, for conversational AI diagnostics)
GEMINI_API_KEY=your_gemini_api_key_here
